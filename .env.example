PORT=4000
MONGODB_URI=mongodb://localhost:27017
DB_NAME=cdrIntelligence

# Connection pool sizing (optional — sane defaults are used if omitted)
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5

# Authentication
JWT_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret

# First-admin bootstrap (used by: npm run first-admin)
FIRST_ADMIN_USERNAME=
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
